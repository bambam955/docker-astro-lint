{
  "name": "docker-astro-lint",
  "private": true,
  "description": "Pinned tool manifest for the Astro static analysis image.",
  "scripts": {
    "astro:version": "node ./scripts/print-astro-version.mjs",
    "astro:versions": "node ./scripts/print-astro-versions.mjs",
    "test": "node --test",
    "update:astro": "node ./scripts/update-astro-version.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "astro": "5.14.8",
    "eslint": "10.4.1",
    "linkinator": "7.6.1",
    "markdownlint-cli2": "0.22.1",
    "playwright": "1.55.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "vitest": "4.0.8"
  }
}
